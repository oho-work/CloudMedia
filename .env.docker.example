# Copy to .env.docker. Docker Compose reads it only when --env-file is supplied.
# External PostgreSQL: replace the hostname/user/database, and URL-encode the password.
# Host database: use host.docker.internal instead of 127.0.0.1.
DATABASE_URL='postgresql://cloudmedia:REPLACE_WITH_URL_ENCODED_PASSWORD@host.docker.internal:5432/postgres'
PGSCHEMA=cloudmedia
APP_AUTH_TOKEN=REPLACE_WITH_A_LONG_RANDOM_TOKEN
BIND_ADDRESS=127.0.0.1
HTTP_PORT=3001

# Optional bundled PostgreSQL: use compose.postgres.yaml as an override and change
# DATABASE_URL to postgresql://cloudmedia:YOUR_PASSWORD@postgres:5432/cloudmedia
# Use the same password here and in DATABASE_URL; URL-encode it only in the URL.
POSTGRES_DB=cloudmedia
POSTGRES_USER=cloudmedia
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_DATABASE_PASSWORD
