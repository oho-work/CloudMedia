# PostgreSQL stores the catalog and poster binaries when configured.
# Connection or image storage failure never falls back to local data files.
DATABASE_URL=
PGSCHEMA=cloudmedia
PORT=3001
HOST=127.0.0.1
# Optional authentication, recommended before binding to the LAN.
APP_AUTH_TOKEN=
ALLOW_PRIVATE_UPSTREAM=false
# Only for the optional file preview mode when DATABASE_URL is empty.
DATA_FILE=./data/cloudmedia.json
POSTER_DIR=./data/posters
