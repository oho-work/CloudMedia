# PostgreSQL is used when configured. An explicit connection failure stops startup.
# Without DATABASE_URL, a local JSON file supports setup and preview.
DATABASE_URL=
PGSCHEMA=cloudmedia
PORT=3001
HOST=127.0.0.1
# Optional authentication, recommended before binding to the LAN.
APP_AUTH_TOKEN=
ALLOW_PRIVATE_UPSTREAM=false
DATA_FILE=./data/cloudmedia.json
POSTER_DIR=./data/posters
